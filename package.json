{
  "name": "dtb-technologies",
  "version": "1.0.0",
  "description": "DTB Technologies Website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run test:intake && npm run test:inbox && npm run test:smartquote && npm run build:css && npm run build:public && npm run test:seo",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "vercel-build": "npm run test:intake && npm run test:inbox && npm run test:smartquote && npm run build:css && npm run build:public && npm run test:seo",
    "test:intake": "node tests/intake-handler.test.cjs",
    "test:inbox": "node tests/inbox-config.test.cjs",
    "test:smartquote": "node --test tests/smartquote.test.cjs",
    "build:public": "node scripts/build-public-site.cjs",
    "test:seo": "node --test tests/seo-foundation.test.cjs tests/seo-content.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTBbuilds/dtbtech.git"
  },
  "keywords": [
    "web",
    "technology",
    "services"
  ],
  "author": "DTB Technologies",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DTBbuilds/dtbtech/issues"
  },
  "homepage": "https://github.com/DTBbuilds/dtbtech#readme",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "autoprefixer": "^10.4.14",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.4.17"
  }
}
