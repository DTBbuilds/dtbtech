# DTB Technologies — Lead Management System
# Copy to .env (local only, never commit) or set in Vercel project settings.
# Names only — fill values from your Supabase project settings.

# Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=

# Modern publishable key (safe for browser use; RLS protects all data)
SUPABASE_PUBLISHABLE_KEY=

# ── DTB-CONVERT-001B: public enquiry intake (server-side only) ──
# The service-role key must NEVER be exposed to the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enquiry notification email (Resend). Absent = notification skipped,
# enquiry still persists with a reference. See docs/enquiry-intake.md.
RESEND_API_KEY=
DTB_NOTIFY_EMAIL=
DTB_NOTIFY_FROM=
